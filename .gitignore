# pixi environments
.pixi/*
!.pixi/config.toml

# Generated paper notes (auto-created by wiki_pipeline.py)
papers/*
!papers/.gitkeep

# Raw extracted content from marker-pdf (large, reproducible)
raw/papers/*
!raw/papers/.gitkeep

# Processed PDFs
processed/*
!processed/.gitkeep

# Failed processing
failed/*
!failed/.gitkeep

# Obsidian
.obsidian/workspace*
.obsidian/graph.json
